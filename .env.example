# Email Delivery Configuration (Resend)
# Obtain an API key from https://resend.com and verify a sending domain.
RESEND_API_KEY=

# Verified sender email address configured in your Resend account (e.g., "Academic Portfolio <contact@yourdomain.com>")
CONTACT_FROM_EMAIL=

# Recipient inbox (defaults to aminamumtazskt@outlook.com if omitted)
CONTACT_TO_EMAIL=aminamumtazskt@outlook.com

# Canonical production site URL for metadata, canonicals, sitemap.xml, and robots.txt
# Preferred domain baseline: https://aminamumtaz.com
# Replace with your verified production origin before deploying live.
NEXT_PUBLIC_SITE_URL=

# Optional Search Engine Ownership Verification Tokens
# Leave blank until domain property verification is initiated in Google Search Console or Bing Webmaster Tools.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
